# Copy to .env and fill in. docker-compose reads this file.

# Public hostname served by Caddy (must resolve to this server; a CNAME is fine).
DOMAIN=tag.example.com

# Web UI admin credentials.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# Optional: instead of ADMIN_PASSWORD, store a PBKDF2 hash:
#   python3 -c "from server.app.security import hash_password; print(hash_password('yourpass'))"
# ADMIN_PASSWORD_HASH=

# Cookie signing secret. Leave empty and one is generated and stored in the data volume.
SECRET=

# Polling interval (minutes) and history retention (days).
POLL_MINUTES=15
RETENTION_DAYS=30

# Hours to look back when querying Apple for reports.
FETCH_WINDOW_HOURS=168

# Set to 0 only if you terminate TLS elsewhere.
HTTPS_ONLY=1
